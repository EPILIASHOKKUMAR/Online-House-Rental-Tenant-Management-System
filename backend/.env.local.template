# Local Environment Variables Template
# Copy this file to .env.local and fill in your actual credentials
# .env.local is ignored by git and won't be committed

# Database Configuration
DB_PASSWORD=your-actual-database-password

# Email Configuration (Your Gmail SMTP)
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-gmail-app-password
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password

# Instructions:
# 1. Copy this file: cp .env.local.template .env.local
# 2. Replace the placeholder values with your actual credentials
# 3. The .env.local file will be ignored by git automatically